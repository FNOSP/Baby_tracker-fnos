#!/bin/bash

set -u

SERVER_DIR="${TRIM_APPDEST}/server"
BIN_DIR="${SERVER_DIR}/bin"
GATEWAY_SOCKET="${TRIM_APPDEST}/app.sock"
DATA_DIR="${TRIM_PKGVAR}/data"
SHARE_DATA_DIR=""
SECRET_FILE="${TRIM_PKGETC}/secret_key"
PORT_FILE="${TRIM_PKGETC}/service_port"
BIND_ADDRESS_FILE="${TRIM_PKGETC}/bind_address"
LOG_FILE="${TRIM_PKGVAR}/app.log"
PID_FILE="${TRIM_PKGVAR}/app.pid"
BINARY_PATH=""

log_msg() {
    printf '%s - %s\n' "$(date '+%Y-%m-%d %H:%M:%S')" "$1" >> "${LOG_FILE}"
}

fail() {
    log_msg "ERROR: $1"
    if [ -n "${TRIM_TEMP_LOGFILE:-}" ]; then
        printf '%s\n' "$1" > "${TRIM_TEMP_LOGFILE}"
    fi
    exit 1
}

fix_ownership() {
    if [ "$(id -u)" -eq 0 ] && [ -n "${TRIM_UID:-}" ] && [ -n "${TRIM_GID:-}" ]; then
        chown -R "${TRIM_UID}:${TRIM_GID}" "$@" >> "${LOG_FILE}" 2>&1 || true
    fi
}

map_data_dir() {
    local share_paths first_share current_target
    share_paths="${TRIM_DATA_SHARE_PATHS:-}"
    first_share="${share_paths%%:*}"

    [ -n "${first_share}" ] || fail "未提供 data-share 共享目录。"
    SHARE_DATA_DIR="${first_share}"
    mkdir -p "${TRIM_PKGVAR}" "${SHARE_DATA_DIR}" || fail "无法创建 data-share 共享目录。"

    if [ -L "${DATA_DIR}" ]; then
        current_target="$(readlink "${DATA_DIR}")"
        [ "${current_target}" = "${SHARE_DATA_DIR}" ] || fail "数据目录映射异常，请卸载应用后重新安装。"
    else
        if [ -d "${DATA_DIR}" ]; then
            rmdir "${DATA_DIR}" 2>/dev/null || fail "检测到旧数据目录，请卸载应用后重新安装。"
        elif [ -e "${DATA_DIR}" ]; then
            fail "检测到旧数据目录，请卸载应用后重新安装。"
        fi
        ln -s "${SHARE_DATA_DIR}" "${DATA_DIR}" || fail "无法将数据目录映射到 data-share。"
    fi

    log_msg "Data directory mapped to shared path: ${SHARE_DATA_DIR}"
}

valid_port() {
    local port="$1"
    case "${port}" in
        ''|*[!0-9]*)
            return 1
            ;;
    esac
    [ "${port}" -ge 1024 ] && [ "${port}" -le 65535 ]
}

resolve_port() {
    local port="${wizard_port:-}"
    if [ -z "${port}" ] && [ -r "${PORT_FILE}" ]; then
        port="$(head -n 1 "${PORT_FILE}" | tr -d '[:space:]')"
    fi
    if [ -z "${port}" ]; then
        return 0
    fi
    valid_port "${port}" || fail "监听端口无效：应为 1024-65535 之间的数字。"
    printf '%s' "${port}"
}

write_port_file() {
    local port="$1" temp_file
    mkdir -p "${TRIM_PKGETC}"
    temp_file="${PORT_FILE}.tmp.$$"
    umask 077
    printf '%s\n' "${port}" > "${temp_file}" || fail "无法保存服务端口。"
    mv "${temp_file}" "${PORT_FILE}" || fail "无法保存服务端口。"
    chmod 600 "${PORT_FILE}"
    fix_ownership "${PORT_FILE}"
}

normalize_bind_address() {
    local value octets first octet normalized
    local regex='^([0-9]{1,3})\.([0-9]{1,3})\.([0-9]{1,3})\.([0-9]{1,3})$'
    value="${1//[[:space:]]/}"
    [[ "${value}" =~ ${regex} ]] || return 1
    octets=("${BASH_REMATCH[1]}" "${BASH_REMATCH[2]}" "${BASH_REMATCH[3]}" "${BASH_REMATCH[4]}")
    normalized=()
    for octet in "${octets[@]}"; do
        local number=$((10#${octet}))
        [ "${number}" -le 255 ] || return 1
        normalized+=("${number}")
    done
    first="${normalized[0]}"
    [ "${first}" -lt 224 ] || [ "${first}" -gt 239 ] || return 1
    printf '%s.%s.%s.%s' "${normalized[0]}" "${normalized[1]}" "${normalized[2]}" "${normalized[3]}"
}

write_bind_address_file() {
    local address="$1" temp_file
    mkdir -p "${TRIM_PKGETC}"
    temp_file="${BIND_ADDRESS_FILE}.tmp.$$"
    umask 077
    printf '%s\n' "${address}" > "${temp_file}" || fail "无法保存监听地址。"
    mv "${temp_file}" "${BIND_ADDRESS_FILE}" || fail "无法保存监听地址。"
    chmod 600 "${BIND_ADDRESS_FILE}"
    fix_ownership "${BIND_ADDRESS_FILE}"
}

resolve_bind_address() {
    local address="${wizard_bind_address:-}" normalized
    if [ -z "${address}" ] && [ -r "${BIND_ADDRESS_FILE}" ]; then
        address="$(head -n 1 "${BIND_ADDRESS_FILE}" | tr -d '[:space:]')"
    fi
    if [ -z "${address}" ]; then
        return 0
    fi
    normalized="$(normalize_bind_address "${address}")" || fail "监听地址无效：请输入有效的 IPv4 地址。"
    printf '%s' "${normalized}"
}

validate_service_values() {
    local bind_address normalized port
    mkdir -p "${TRIM_PKGVAR}" "${TRIM_PKGETC}"

    bind_address="${wizard_bind_address:-}"
    port="${wizard_port:-}"

    if [ -z "${bind_address}" ] && [ -z "${port}" ]; then
        rm -f "${BIND_ADDRESS_FILE}" "${PORT_FILE}"
        return 0
    fi
    if [ -z "${bind_address}" ] || [ -z "${port}" ]; then
        fail "监听地址和监听端口需同时填写；两项留空则关闭额外监听。"
    fi

    valid_port "${port}" || fail "监听端口无效：应为 1024-65535 之间的数字。"
    normalized="$(normalize_bind_address "${bind_address}")" || fail "监听地址无效：请输入有效的 IPv4 地址。"
    write_port_file "${port}"
    write_bind_address_file "${normalized}"
}

select_binary() {
    local arch
    if [ -n "${BABY_TRACKER_BINARY:-}" ]; then
        BINARY_PATH="${BABY_TRACKER_BINARY}"
    else
        arch="$(uname -m)"
        case "${arch}" in
            x86_64|amd64) BINARY_PATH="${BIN_DIR}/baby-tracker-linux-amd64" ;;
            aarch64|arm64) BINARY_PATH="${BIN_DIR}/baby-tracker-linux-arm64" ;;
            *) fail "不支持的 CPU 架构：${arch}。" ;;
        esac
    fi
    [ -x "${BINARY_PATH}" ] || fail "Baby Tracker Go 运行时不存在或不可执行：${BINARY_PATH}"
}

generate_secret() {
    local encoded temp_file
    if [ -s "${SECRET_FILE}" ]; then
        return 0
    fi
    mkdir -p "${TRIM_PKGETC}"
    temp_file="${SECRET_FILE}.tmp.$$"
    encoded="$(head -c 48 /dev/urandom | base64 | tr -d '\r\n')" || fail "无法生成应用密钥。"
    [ -n "${encoded}" ] || fail "无法生成应用密钥。"
    umask 077
    printf '%s\n' "${encoded}" > "${temp_file}" || fail "无法保存应用密钥。"
    mv "${temp_file}" "${SECRET_FILE}" || fail "无法保存应用密钥。"
    chmod 600 "${SECRET_FILE}"
    fix_ownership "${SECRET_FILE}"
}

bootstrap_database() {
    log_msg "Applying database schema with Go runtime..."
    env \
        BABY_TRACKER_DATA_DIR="${DATA_DIR}" \
        BABY_TRACKER_WEB_DIR="${SERVER_DIR}" \
        "${BINARY_PATH}" bootstrap >> "${LOG_FILE}" 2>&1 \
        || fail "初始化应用数据库失败。"
}

check_process() {
    local pid="$1"
    [ -n "${pid}" ] && kill -0 "${pid}" 2>/dev/null
}

status_process() {
    if [ -r "${PID_FILE}" ]; then
        local pid
        pid="$(head -n 1 "${PID_FILE}" | tr -d '[:space:]')"
        if check_process "${pid}"; then
            return 0
        fi
        rm -f "${PID_FILE}"
    fi
    return 1
}

prepare_runtime() {
    map_data_dir
    mkdir -p "${TRIM_PKGVAR}" "${TRIM_PKGETC}" "${DATA_DIR}" "${TRIM_PKGTMP}" "${BIN_DIR}"
    fix_ownership "${TRIM_PKGVAR}" "${TRIM_PKGETC}" "${TRIM_PKGTMP}"
    if [ -z "${SHARE_DATA_DIR}" ]; then
        fix_ownership "${DATA_DIR}"
    fi
    select_binary
    generate_secret
    bootstrap_database
}

start_process() {
    status_process && return 0
    prepare_runtime

    local secret_key bind_address service_port launcher_path
    secret_key="$(cat "${SECRET_FILE}")"
    bind_address="$(resolve_bind_address)"
    service_port="$(resolve_port)"
    if { [ -n "${bind_address}" ] && [ -z "${service_port}" ]; } || { [ -z "${bind_address}" ] && [ -n "${service_port}" ]; }; then
        fail "监听配置不完整：请同时设置监听地址和监听端口，或两项都留空。"
    fi

    if [ -n "${bind_address}" ] && [ -n "${service_port}" ]; then
        log_msg "Starting Baby Tracker gateway socket and TCP listener on ${bind_address}:${service_port}..."
    else
        log_msg "Starting Baby Tracker gateway socket only; no additional TCP listener configured."
    fi

    if [ -S "${GATEWAY_SOCKET}" ]; then
        rm -f "${GATEWAY_SOCKET}" || fail "无法清理旧的统一网关 Socket。"
    fi

    launcher_path="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/$(basename "${BASH_SOURCE[0]}")"
    local -a app_environment=(
        "SECRET_KEY=${secret_key}"
        "BABY_TRACKER_WEB_DIR=${SERVER_DIR}"
        "BABY_TRACKER_DATA_DIR=${DATA_DIR}"
        "BABY_TRACKER_GATEWAY_SOCKET=${GATEWAY_SOCKET}"
        "BABY_TRACKER_GATEWAY_PREFIX=/app/baby-tracker"
        "TRIM_APPDEST=${TRIM_APPDEST}"
        "TRIM_PKGVAR=${TRIM_PKGVAR}"
        "TRIM_PKGETC=${TRIM_PKGETC}"
        "TRIM_PKGTMP=${TRIM_PKGTMP}"
        "TRIM_DATA_SHARE_PATHS=${TRIM_DATA_SHARE_PATHS:-}"
        "TRIM_UID=${TRIM_UID:-}"
        "TRIM_GID=${TRIM_GID:-}"
        "BABY_TRACKER_CMD_MAIN=${launcher_path}"
        "BABY_TRACKER_BIND_ADDRESS=${bind_address}"
        "BABY_TRACKER_SERVICE_PORT=${service_port}"
    )
    if [ -n "${bind_address}" ] && [ -n "${service_port}" ]; then
        app_environment+=("BABY_TRACKER_LISTEN_ADDRESS=${bind_address}:${service_port}")
    fi

    nohup env "${app_environment[@]}" "${BINARY_PATH}" serve >> "${LOG_FILE}" 2>&1 &
    local pid="$!"
    printf '%s' "${pid}" > "${PID_FILE}"
    sleep 1
    if ! check_process "${pid}"; then
        rm -f "${PID_FILE}"
        fail "Baby Tracker 启动失败，请查看 ${LOG_FILE}。"
    fi
    log_msg "Baby Tracker started with PID ${pid}."
    return 0
}

stop_process() {
    if ! status_process; then
        return 0
    fi

    local pid count
    pid="$(head -n 1 "${PID_FILE}" | tr -d '[:space:]')"
    log_msg "Stopping Baby Tracker PID ${pid}..."
    kill -TERM "${pid}" 2>> "${LOG_FILE}" || true

    count=0
    while check_process "${pid}" && [ "${count}" -lt 15 ]; do
        sleep 1
        count=$((count + 1))
    done

    if check_process "${pid}"; then
        log_msg "Process did not stop in time; sending KILL."
        kill -KILL "${pid}" 2>> "${LOG_FILE}" || true
    fi
    rm -f "${PID_FILE}"
    return 0
}

restart_process() {
    sleep 1
    stop_process
    start_process
}

if [ "${BASH_SOURCE[0]}" = "$0" ]; then
case "${1:-}" in
    install)
        prepare_runtime
        ;;
    prepare)
        prepare_runtime
        ;;
    configure)
        validate_service_values
        ;;
    start)
        start_process
        ;;
    stop)
        stop_process
        ;;
    restart)
        restart_process
        ;;
    status)
        if status_process; then
            exit 0
        fi
        exit 3
        ;;
    *)
        fail "未知命令: ${1:-}"
        ;;
esac
fi
